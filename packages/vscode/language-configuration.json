{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#>", "<#"]
  },
  "wordPattern": "[A-Za-z_]\\w*",
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["#>", "<#"], ["#<", ">#"], ["#[", "]#"]],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]]
}
