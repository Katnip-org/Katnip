{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#>", "<#"]
  },
  "wordPattern": "[A-Za-z_]\\w*",
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], { "open": "'", "close": "'", "notIn": ["string", "comment"] }, ["#>", "<#"], ["#<", ">#"], ["#[", "]#"]],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]]
}
