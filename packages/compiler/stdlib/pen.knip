#> pen.knip ~ pen extension blocks. <#

public enum ColorParam { COLOR = "color", SATURATION = "saturation", BRIGHTNESS = "brightness", TRANSPARENCY = "transparency" }

proc down(@opcode = "pen_penDown") -> void {}
proc up(@opcode = "pen_penUp") -> void {}
proc clear(@opcode = "pen_clear") -> void {}
proc setHex(@opcode = "pen_setPenColorToColor", hex: str) -> void {}

proc setAttr(@opcode = "pen_setPenColorParamTo", attr: ColorParam, value: num) -> void {}
proc changeAttr(@opcode = "pen_changePenColorParamBy", attr: ColorParam, dA: num) -> void {}

proc setSize(@opcode = "pen_setPenSizeTo", size: num) -> void {}
proc changeSize(@opcode = "pen_changePenSizeBy", dS: num) -> void {}