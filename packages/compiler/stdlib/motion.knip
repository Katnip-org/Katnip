#> motion.knip ~ sprite motion blocks. <#

public enum Target { RANDOM = "_random_", MOUSE = "_mouse_" }
public enum RotationStyle { LEFT_RIGHT = "left-right", ALL_AROUND = "all around", NONE = "don't rotate" }

proc forward(@opcode = "motion_movesteps", steps: num) -> void {}
proc turn(@opcode = "motion_turnright", degrees: num) -> void {}

proc goTo(@opcode = "motion_goto", position: Target | str) -> void {}
proc goTo(@opcode = "motion_gotoxy", x: num, y: num) -> void {}
proc glideTo(@opcode = "motion_glideto", time: num, position: Target | str) -> void {}
proc glideTo(@opcode = "motion_glidesecstoxy", time: num, x: num, y: num) -> void {}

proc point(@opcode = "motion_pointindirection", degrees: num) -> void {}
proc point(@opcode = "motion_pointtowards", target: Target | str) -> void {}

proc changeX(@opcode = "motion_changexby", dX: num) -> void {}
proc setX(@opcode = "motion_setx", x: num) -> void {}
proc changeY(@opcode = "motion_changeyby", dY: num) -> void {}
proc setY(@opcode = "motion_sety", y: num) -> void {}

proc ifOnEdgeBounce(@opcode = "motion_ifonedgebounce") -> void {}
proc setRotationStyle(@opcode = "motion_setrotationstyle", style: RotationStyle) -> void {}

proc getPosition(@opcode = "katnip_motion_position") -> (num, num) {}
