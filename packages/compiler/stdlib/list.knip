#! katnip: stdlib
#> list.knip ~ methods on list values (first param `self` marks a method). <#

proc add(@opcode = "data_addtolist", self: list<T>, item: T) -> void {}
proc contains(@opcode = "data_listcontainsitem", self: list<T>, item: T) -> bool {}
proc length(@opcode = "data_lengthoflist", self: list<T>) -> num {}
proc insert(@opcode = "data_insertatlist", self: list<T>, item: T, idx: num) -> void {}
proc remove(@opcode = "data_deleteoflist", @lower = "yields", self: list<T>, idx: num) -> T {}
proc clear(@opcode = "data_deletealloflist", self: list<T>) -> void {}
proc indexOf(@opcode = "data_itemnumoflist", self: list<T>, item: T) -> num {}

proc show(@opcode = "data_showlist", self: list<T>) -> void {}
proc hide(@opcode = "data_hidelist", self: list<T>) -> void {}

proc merge(self: list<T>, addition: list<T>) -> void {
    # A for re-reads its count every iteration, so merging a list into itself needs the count held still
    private count: num = addition.length();
    for (i, count) { self.add(addition[i]); }
}

# dst = self[start:stop:step]: 1-based, stop-inclusive, like range(). dst must not be self.
proc sliceInto(@operator = "[:]list", self: list<T>, dst: list<T>, start: num, stop: num, step: num = 1) -> void {
    dst.clear();
    private i: num = start;
    if (step > 0) {
        while (i <= stop) {
            if (i > 0 && i <= self.length()) { dst.add(self[i]); }
            i += step;
        }
    } elif (step < 0) {
        while (i >= stop) {
            if (i > 0 && i <= self.length()) { dst.add(self[i]); }
            i += step;
        }
    }
}