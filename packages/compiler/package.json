{
  "name": "@katnip-org/compiler",
  "version": "0.1.11",
  "description": "Compiler and type-checker for the Katnip language (.knip), targeting Scratch SB3.",
  "license": "Apache-2.0",
  "author": "Benjamin Clark",
  "homepage": "https://katnip.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Katnip-org/Katnip.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/Katnip-org/Katnip/issues"
  },
  "keywords": [
    "katnip",
    "scratch",
    "sb3",
    "compiler",
    "language"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "katnip": "build/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "stdlib",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/yargs": "^17.0.33",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "prebuild": "node scripts/gen-stdlib.mjs",
    "build": "tsc",
    "test": "npm run build && node --test \"build/tests/*.test.js\"",
    "prepublishOnly": "npm run build"
  }
}
