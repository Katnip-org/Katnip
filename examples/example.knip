closing it now <#

# Procedure: print a message to console
proc log(
    @proccode = "log %s",
    @doc = "Logs a message to the console.",
    msg: str = "No message."
) -> void {
    console.log(msg);
}

# Procedure: calculate score using exponentiation
proc score(
    @proccode = "score %n ^ %n",
    @constants = {"avogadro":6.022e23},
    base: num,
    exp: num = 2
) -> num {
    return(base ** exp);
}

proc thing(one: num, two: num) -> num {
    return(one + two);
}

# User interaction + clone creation
proc start() -> void {
    private name = console.input("What is your name?");
    console.log("Welcome, " + name + "!");

    for(i, range(1, 3)){
        console.log("Attempt #" + i);
    }

    clone.create("myself");
}